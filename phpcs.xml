<?xml version="1.0"?>
<ruleset name="AiWA Identity Animation">
    <description>PHPCS ruleset: WordPress + PSR-12 for AiWA Identity Animation</description>

    <file>aiwa-identity-animation.php</file>
    <file>uninstall.php</file>
    <file>src/includes/</file>

    <arg name="basepath" value="."/>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <!-- PHP 7.4+ -->
    <config name="testVersion" value="7.4-"/>

    <!-- WordPress standards -->
    <rule ref="WordPress-Extra"/>
    <rule ref="WordPress-Docs"/>

    <!-- PSR-12 on top of WordPress standards -->
    <rule ref="PSR1.Classes.ClassDeclaration"/>
    <rule ref="PSR2.Methods.MethodDeclaration"/>

    <!-- Namespace: AiWA\IdentityAnimation -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="aiwa_"/>
                <element value="AIWA_"/>
                <element value="AIWA_IDENTITY_ANIMATION"/>
                <element value="AiWA\IdentityAnimation"/>
            </property>
        </properties>
    </rule>

    <!-- Text domain -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="aiwa-identity-animation"/>
            </property>
        </properties>
    </rule>

    <!-- Allow short array syntax -->
    <rule ref="Universal.Arrays.DisallowShortArraySyntax">
        <exclude name="Universal.Arrays.DisallowShortArraySyntax.Found"/>
    </rule>
    <rule ref="Universal.Operators.DisallowShortTernary">
        <exclude name="Universal.Operators.DisallowShortTernary.Found"/>
    </rule>
    <exclude-pattern>*/NormalizedArrays/*</exclude-pattern>
    <rule ref="NormalizedArrays.Arrays.ArrayBraceSpacing">
        <exclude name="NormalizedArrays.Arrays.ArrayBraceSpacing.SpaceAfterArrayOpenerSingleLine"/>
        <exclude name="NormalizedArrays.Arrays.ArrayBraceSpacing.SpaceBeforeArrayCloserSingleLine"/>
    </rule>
    <rule ref="WordPress.Files.FileName.InvalidClassFileName">
        <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
    </rule>

    <!-- PSR-12 Brace Style -->
    <rule ref="Generic.Functions.OpeningFunctionBraceKernighanRitchie">
        <exclude name="Generic.Functions.OpeningFunctionBraceKernighanRitchie.BraceOnNewLine"/>
    </rule>
    <rule ref="Generic.Classes.OpeningBraceSameLine">
        <exclude name="Generic.Classes.OpeningBraceSameLine.BraceOnNewLine"/>
    </rule>
</ruleset>
